  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "用户 JWT；在上传/分享管理与 /user/api-keys 之外的第三方调用中，也可传 API Key 明文（fcb_sk_ 前缀，按前缀自动识别）"
      },
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "用户级 API Key（用户中心 /user/tokens 签发）；等价形式：Authorization: Bearer fcb_sk_xxx / Authorization: ApiKey fcb_sk_xxx"
      }
    },
    "schemas": {
      "UserShareItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "code": {
            "type": "string"
          },
          "file_name": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "format": "int64"
          },
          "text": {
            "type": "string"
          },
          "expired_at": {
            "type": "string",
            "nullable": true
          },
          "expired_count": {
            "type": "integer"
          },
          "used_count": {
            "type": "integer"
          },
          "viewer_ip": {
            "type": "string"
          },
          "viewer_at": {
            "type": "string",
            "nullable": true
          },
          "viewer_count": {
            "type": "integer"
          },
          "is_expired": {
            "type": "boolean"
          },
          "is_text_share": {
            "type": "boolean"
          },
          "deleted_at": {
            "type": "string",
            "nullable": true
          },
          "created_at": {
            "type": "string"
          }
        }
      }
    }
  }
}